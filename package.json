{
  "name": "sursaath",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SurSaath: a static tanpura and taal box practice app for Indian classical riyaaz.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:android": "npm run build -- --base=./ && cap sync android",
    "android:assets": "capacitor-assets generate --android --iconBackgroundColor '#12151c' --iconBackgroundColorDark '#12151c' --splashBackgroundColor '#12151c' --splashBackgroundColorDark '#12151c'",
    "android:debug": "npm run build:android && cd android && ./gradlew assembleDebug",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.1",
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1"
  }
}
